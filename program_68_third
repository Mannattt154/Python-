# WAP to input two lists and create a third list containing common elements.
list1 = []
list2 = []
n1 = int(input("enter total numbers in list 1"))
n2 = int(input("enter total numbers in list 2"))
for i in range(n1):
    num = int(input("enter number for list 1"))
    list1.append(num)
for i in range(n2):
    num = int(input("enter number for list 2"))
    list2.append(num)
common = []
for num in list1:
    if num in list2 and num not in common:
        common.append(num)
print("Common elements: ", common)
