#write apython program to input marks of n students in a list.Display highest marks, lowest marks, average marks, and number of students who passed
n = int(input("Enter number of students: "))
marks = []
for i in range(n):
    mark = float(input(f"Enter marks of student {i + 1}: "))
    marks.append(mark)

highest = max(marks)
lowest = min(marks)
average = sum(marks) / n

passed = 0
for mark in marks:
    if mark >= 40:
        passed += 1

print("\nHighest marks:", highest)
print("Lowest marks:", lowest)
print("Average marks:", average)
print("Number of students passed:", passed
