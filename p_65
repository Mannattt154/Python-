# WAP to input numbers in a list and create two seperate lists for even and odd numbers
numbers = []
even = []
odd = []
n = int(input("enter total numbers"))
for i in range(n):
    num = int(input("enter number"))
    numbers.append(num)
    for num in numbers:
        if num % 2 == 0:
            even.append(num)
        else:
            odd.append(num)
