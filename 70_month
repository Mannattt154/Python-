#wap to store all the numbers in a tuple. input a month number and display the corresponding month name.
months = ( "January",
           "February",
             "March",
               "April",
                 "May",
                   "June",
                     "July",
                       "August",
                         "September",
                           "October",
                             "November",
                               "December"
                               )
month_number = int(input("Enter month number (1-12): "))
if 1 <= month_number <= 12:
    month_name = months[month_number - 1]
    print("Month name:", month_name)
else:
    print("Invalid month number")
